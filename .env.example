# Provided automatically by Vercel when you attach a Postgres database
# (Neon, via the Vercel Marketplace) to this project. For local
# development, copy the values from Vercel Project Settings → Storage →
# your database → ".env.local" tab.
DATABASE_URL=

# A long random string used to sign admin session cookies.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
