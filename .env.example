# Any Postgres provider from the Vercel Marketplace works (Neon, Supabase,
# Prisma Postgres, etc.) as long as you use a plain "postgres://" style
# connection string — not a proxy/accelerate URL. Vercel usually injects
# this as POSTGRES_URL; some providers (e.g. Prisma Postgres) instead set
# DATABASE_URL to a proxy URL that only their own client understands — in
# that case, use the "direct connection" string from your provider instead.
POSTGRES_URL=
DATABASE_URL=

# A long random string used to sign admin session cookies.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
